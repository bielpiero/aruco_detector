<launch>

  <!-- Lanzar la cámara RealSense -->
  <include file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="enable_pointcloud" value="true"/>
    <arg name="enable_color" value="true"/>
    <arg name="color_width" value="1920"/>
    <arg name="color_height" value="1080"/>
    <arg name="color_fps" value="30"/>
    <arg name="align_depth" value="true"/>
    <arg name="ordered_pc" value="true"/>
  </include>

  <!-- Esperar un poco antes de lanzar el detector (opcional) -->
  <group ns="aruco">
    <node pkg="aruco_detector" type="aruco_detector" name="aruco_detector" output="screen"/>
  </group>

</launch>
